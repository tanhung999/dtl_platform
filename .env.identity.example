# Copy to .env.identity on the server. Do not replace .env.production.
# Load BOTH files: --env-file .env.production --env-file .env.identity
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN=identity-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
# Keep false until account links and parallel rehearsal have passed.
PLATFORM_IDENTITY_ENABLED=false
