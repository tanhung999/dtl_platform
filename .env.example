# DTL Platform Environment Configuration
APP_NAME="DTL Platform"
APP_ENV=development
DEBUG=true
ALLOW_INSECURE_LOCAL_CONFIG=true
PLATFORM_BACKEND_PORT=8001
# Production capacity profile for 500 concurrent active users.
PLATFORM_API_WORKERS=4
PLATFORM_WORKER_CONCURRENCY=400
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10

# Security Keys (Đổi khi đưa lên Production)
SECRET_KEY=dtl_platform_super_secret_key_change_in_production_2026
SSO_SECRET_KEY=dtl_sso_shared_secret_for_ticket_exchange_32_chars
ACCESS_TOKEN_MINUTES=480
SSO_TICKET_EXPIRE_SECONDS=60

# Database
# Mặc định dev cục bộ: SQLite
DATABASE_URL=sqlite+aiosqlite:///./platform.db
# Hoặc PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@localhost:5434/dtl_platform_db

# URLs của 3 Sub-applications
BOOKING_REPORTS_URL=http://localhost:3000
WORKFLOWS_URL=http://localhost:8082
ASSET_MANAGER_URL=http://localhost:8444

# Keycloak local/staging. Đổi toàn bộ secret trước khi dùng ngoài máy phát triển.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_DB_PASSWORD=keycloak-local-password
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=platform-user-admin-local-secret-change-me
KEYCLOAK_PUBLIC_URL=http://localhost:5173/auth
KEYCLOAK_ADMIN_URL=http://localhost:8081/auth
PLATFORM_OIDC_CLIENT_SECRET=platform-local-secret-change-me
BOOKINGREPORTS_OIDC_CLIENT_SECRET=booking-local-secret-change-me
WORKFLOWS_OIDC_CLIENT_SECRET=workflows-local-secret-change-me
ASSET_MANAGER_OIDC_CLIENT_SECRET=assets-local-secret-change-me
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:5173/auth/realms/dtl
OIDC_AUTHORIZATION_URL=http://localhost:5173/auth/realms/dtl/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://localhost:8081/auth/realms/dtl/protocol/openid-connect/token
OIDC_JWKS_URL=http://localhost:8081/auth/realms/dtl/protocol/openid-connect/certs
OIDC_END_SESSION_URL=http://localhost:5173/auth/realms/dtl/protocol/openid-connect/logout
OIDC_AUDIENCE=dtl-platform
OIDC_CLIENT_ID=dtl-platform
OIDC_CLIENT_SECRET=platform-local-secret-change-me
OIDC_SESSION_ENCRYPTION_SECRET=local-session-encryption-change-me
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
OIDC_FRONTEND_URL=http://localhost:5173
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
OIDC_SESSION_COOKIE_SECURE=false
OIDC_AUTO_LINK_EXISTING_USERS=false
BOOKINGREPORTS_INTEGRATION_SECRET=replace-with-a-random-bookingreports-secret-of-at-least-32-characters
WORKFLOWS_INTEGRATION_SECRET=replace-with-a-random-workflows-secret-of-at-least-32-characters
# Optional account linking. Empty values keep it disabled. Use a separate 32+ character key.
WORKFLOWS_ACCOUNT_LINKING_URL=
WORKFLOWS_ACCOUNT_LINKING_SECRET=
ITAM_INTEGRATION_SECRET=replace-with-a-random-itam-secret-of-at-least-32-characters

# Dọn dữ liệu theo lô; đặt số ngày bằng 0 để giữ vô hạn bảng tương ứng.
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=600
MAINTENANCE_BATCH_SIZE=500
SCHEDULE_HISTORY_RETENTION_DAYS=365
PROCESSED_JOB_RETENTION_DAYS=30

# API hộp thông báo chung: dùng khóa ngẫu nhiên riêng, tối thiểu 32 ký tự.
# Khóa SIGNING chỉ đặt ở Platform; mỗi ứng dụng giữ đúng API_SECRET của mình.
NOTIFICATIONS_API_SIGNING_SECRET=
NOTIFICATIONS_BOOKINGREPORTS_API_SECRET=
NOTIFICATIONS_WORKFLOWS_API_SECRET=
NOTIFICATIONS_ITAM_API_SECRET=
NOTIFICATIONS_API_TOKEN_SECONDS=900
NOTIFICATIONS_API_SESSION_SECONDS=28800
