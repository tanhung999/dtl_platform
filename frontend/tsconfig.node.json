{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "src/theme/**/*.ts",
    "src/theme/*.json"
  ]
}
