{
  "realm": "dtl",
  "enabled": true,
  "displayName": "Đông Tây One",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername(undefined)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "clients": [
    {
      "clientId": "dtl-platform",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PLATFORM_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [{
        "name": "platform-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "config": {"included.client.audience": "dtl-platform", "id.token.claim": "false", "access.token.claim": "true"}
      }]
    },
    {
      "clientId": "platform-user-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_USER_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [{
    "username": "service-account-platform-user-admin",
    "enabled": true,
    "serviceAccountClientId": "platform-user-admin",
    "clientRoles": {"realm-management": ["manage-users", "view-users", "query-users"]}
  }]
}
