{
  "realm": "dtl",
  "displayName": "Đông Tây Land",
  "loginTheme": "dtl",
  "internationalizationEnabled": true,
  "defaultLocale": "vi",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and notUsername(undefined)",
  "clients": [
    {
      "clientId": "dtl-platform",
      "name": "DTL Platform",
      "enabled": true,
      "publicClient": false,
      "secret": "${PLATFORM_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:5173/*" },
      "protocolMappers": [{"name":"audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.client.audience":"dtl-platform","id.token.claim":"false","access.token.claim":"true"}}]
    },
    {
      "clientId": "bookingreports",
      "name": "Booking Reports",
      "enabled": true,
      "publicClient": false,
      "secret": "${BOOKINGREPORTS_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5174/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5174"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [{"name":"audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.client.audience":"bookingreports","id.token.claim":"false","access.token.claim":"true"}}]
    },
    {
      "clientId": "workflows",
      "name": "DT Workflows",
      "enabled": true,
      "publicClient": false,
      "secret": "${WORKFLOWS_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8082/*"],
      "webOrigins": ["http://localhost:8082"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:8082/*" },
      "protocolMappers": [{"name":"audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.client.audience":"workflows","id.token.claim":"false","access.token.claim":"true"}}]
    },
    {
      "clientId": "asset-manager",
      "name": "DT Asset Manager",
      "enabled": true,
      "publicClient": false,
      "secret": "${ASSET_MANAGER_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8444/*"],
      "webOrigins": ["http://localhost:8444"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [{"name":"audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.client.audience":"asset-manager","id.token.claim":"false","access.token.claim":"true"}}]
    },
    {
      "clientId": "platform-user-admin",
      "name": "Platform User Administration",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_USER_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-platform-user-admin",
      "enabled": true,
      "serviceAccountClientId": "platform-user-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ],
  "groups": [
    {"name":"Ban Giám đốc"},
    {"name":"Công nghệ & Chuyển đổi số"},
    {"name":"Kế toán"},
    {"name":"Kinh doanh"},
    {"name":"Hành chính"}
  ]
}
